#!/bin/bash
set -euo pipefail
printf '%s ' "$@" >> "$UPDATE_CALLS"
printf '\n' >> "$UPDATE_CALLS"
case "$1" in
  compose)
    arguments=" $* "
    if [[ "$arguments" == *' config '* ]]; then
      image=sha256:fixture-image
      [[ ${UPDATE_OVERRIDE_IMAGE:-} != 1 ]] || image=sha256:other-image
      jq -n --arg image "$image" '{name:"fixture",services:({eramba:{image:"sha256:fixture-image"},cron:{image:"sha256:fixture-image"},deployment_prepare:{image:$image}} | with_entries(.value.environment={DB_HOST:"mysql",DB_PORT:"3306",DB_DATABASE:"fixture",DB_USERNAME:"fixture",DB_PASSWORD:"fixture"}) | .deployment_prepare.volumes=[{type:"volume",source:"fixture_data",target:"/var/www/eramba/app/upgrade/data"},{type:"volume",source:"fixture_logs",target:"/var/www/eramba/app/upgrade/logs"}] | .eramba.volumes=.deployment_prepare.volumes | .cron.volumes=.deployment_prepare.volumes),volumes:{app:{name:"fixture_app"},"db-data":{name:"fixture_db-data"},data:{name:"fixture_data"},logs:{name:"fixture_logs"}}}'
    elif [[ "$arguments" == *' identity '* ]]; then
      printf 'fixture-code\n'
    elif [[ "$arguments" == *' status '* ]]; then
      [[ ${UPDATE_REPEAT:-} == 1 ]] && printf '%s\n' '{"phase":"OPEN","preparedCode":"fixture-code","preparedDatabase":"fixture-db"}' || printf '%s\n' '{"phase":"OPEN","preparedCode":"previous-code","preparedDatabase":"fixture-db"}'
    elif [[ "$arguments" == *' ps '* ]]; then
      printf 'fixture-mysql-id\n'
    elif [[ "$arguments" == *'prepare-host'* ]]; then
      printf 'fixture-preparation-id\n'
    elif [[ "$arguments" == *' up '* ]]; then
      touch "$UPDATE_CALLS.activated"
    fi
    ;;
  exec)
    [[ "$*" != *host-drained* || ${UPDATE_FAILURE:-} != drain ]] || exit 75
    if [[ "$*" == *host-drained* ]]; then
      target=fixture-code
      [[ ${UPDATE_DRAINED_TARGET:-} != 1 ]] || target=other-code
      printf '{"operationId":"%s","target":"%s"}\n' "${@: -1}" "$target"
    fi
    ;;
  inspect)
    if [[ "$*" == *'{{.Image}}'* ]]; then
      [[ ${UPDATE_IMAGE_CHANGED:-} == 1 && ! -f "$UPDATE_CALLS.activated" && "$*" != *fixture-preparation-id* ]] && printf 'sha256:previous-image\n' || printf 'sha256:fixture-image\n'
    else
      printf 'true\n'
    fi
    ;;
  image)
    [[ "$*" == *sha256:other-image* ]] && printf 'sha256:other-image\n' || printf 'sha256:fixture-image\n'
    ;;
  volume)
    if [[ "$2" == inspect ]]; then
      [[ ${UPDATE_FAILURE:-} == ownership ]] && printf 'foreign app\n' || printf 'fixture app\n'
    fi
    ;;
  wait) printf '0\n' ;;
  run)
    if [[ "$*" == *database-identity* ]]; then
      [[ ${UPDATE_DATABASE_CHANGED:-} == 1 ]] && printf 'other-db\n' || printf 'fixture-db\n'
    else
      printf 'fixture-code\n'
    fi
    ;;
  pull|load|rm) ;;
  *) exit 64 ;;
esac
