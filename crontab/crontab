@hourly (. /etc/eramba-cron.env && /bin/sh /var/www/eramba/app/upgrade/bin/cake cron job hourly) >> /var/log/cron.log 2>&1
@daily (. /etc/eramba-cron.env && /bin/sh /var/www/eramba/app/upgrade/bin/cake cron job daily) >> /var/log/cron.log 2>&1
@yearly (. /etc/eramba-cron.env && /bin/sh /var/www/eramba/app/upgrade/bin/cake cron job yearly) >> /var/log/cron.log 2>&1
* * * * * (. /etc/eramba-cron.env && /bin/sh /var/www/eramba/app/upgrade/bin/cake queue run -v) >> /var/log/cron.log 2>&1
# remember to end this file with an empty new line
