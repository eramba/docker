DB_HOST=mysql
DB_DATABASE=docker
DB_USERNAME=docker
DB_PASSWORD=Your_DB_user_P@ssw0rd
CACHE_URL=Redis://?server=redis&port=6379&password=&timeout=3
MYSQL_ROOT_PASSWORD=Your_MysQl_ROOt_P@ssw0rd
USE_PROXY=0
PROXY_HOST=
PROXY_PORT=
USE_PROXY_AUTH=0
PROXY_AUTH_USER=
PROXY_AUTH_PASS=
PUBLIC_ADDRESS=https://localhost:8443
# Internal Docker IPv4 network and a free, non-gateway address reserved for Caddy.
# Existing installations: follow the README network migration before updating.
APP_INTERNAL_SUBNET=172.30.250.0/24
# Dynamic container allocation must stay inside the subnet and exclude Caddy.
APP_INTERNAL_DYNAMIC_RANGE=172.30.250.128/25
PUBLIC_PROXY_IP=172.30.250.2
# Optional external LB IPs/CIDRs, SPACE-separated (not comma-separated).
# Empty trusts no external proxies. Use only the actual LB peers/chains.
EXTERNAL_TRUSTED_PROXIES=
ERAMBA_MCP_IMAGE_TAG=latest
OAUTH2_INTROSPECTION_CLIENT_ID=eramba-mcp-introspect
OAUTH2_INTROSPECTION_CLIENT_SECRET=Replace-this-with-a-unique-secret
DOCKER_DEPLOYMENT=1
LDAPTLS_REQCERT=never
TRIGGER_RUNNER_SHARED_SECRET=c86b1a9edd5fdad7f85c95775f42246d761c5486b9059b7db23efc69410b9eaf
