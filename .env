DB_HOST=mysql
DB_DATABASE=docker
DB_USERNAME=docker
DB_PASSWORD=Your_DB_user_P@ssw0rd
CACHE_URL=Redis://?server=redis&port=6379&password=&timeout=3
MYSQL_ROOT_PASSWORD=Your_MysQl_ROOt_P@ssw0rd
USE_PROXY=0
PROXY_HOST=
PROXY_PORT=
USE_PROXY_AUTH=0
PROXY_AUTH_USER=
PROXY_AUTH_PASS=
PUBLIC_ADDRESS=https://localhost:8443
# Reserved Caddy IP outside the dynamic pool. Change all three together if the
# subnet overlaps your LAN, VPN or another Docker network. See README for upgrades.
APP_INTERNAL_SUBNET=172.30.50.0/24
APP_INTERNAL_IP_RANGE=172.30.50.128/25
PUBLIC_PROXY_IP=172.30.50.10
# Apache: comma-separated IPs/CIDRs of trusted proxies, including public_proxy.
# Empty or unset uses PUBLIC_PROXY_IP automatically. A nonempty list replaces
# that default and must include Caddy's IP when using the bundled public_proxy.
TRUSTED_PROXIES=
# Caddy: space-separated IPs/CIDRs of proxies in FRONT of public_proxy only.
# Leave empty when clients connect directly to public_proxy.
CADDY_TRUSTED_PROXIES=
ERAMBA_MCP_IMAGE_TAG=latest
OAUTH2_INTROSPECTION_CLIENT_ID=eramba-mcp-introspect
OAUTH2_INTROSPECTION_CLIENT_SECRET=Replace-this-with-a-unique-secret
DOCKER_DEPLOYMENT=1
LDAPTLS_REQCERT=never
TRIGGER_RUNNER_SHARED_SECRET=c86b1a9edd5fdad7f85c95775f42246d761c5486b9059b7db23efc69410b9eaf
